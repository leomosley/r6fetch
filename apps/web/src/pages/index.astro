---
import { RANK_ART_MAP } from "@r6fetch/renderer";

const DOMAIN = import.meta.env.PUBLIC_DOMAIN ?? "r6fetch.cc";

function escapeHtml(value: string): string {
  return value
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

function ansiToHtml(line: string): string {
  const chars: { char: string; color?: string }[] = [];
  let currentColor: string | undefined;
  let i = 0;

  while (i < line.length) {
    if (line[i] === "\u001b" && line[i + 1] === "[") {
      const end = line.indexOf("m", i);
      if (end !== -1) {
        const seq = line.slice(i + 2, end);
        if (seq === "0") {
          currentColor = undefined;
        } else if (seq.startsWith("38;2;")) {
          currentColor = seq.slice(5);
        }
        i = end + 1;
        continue;
      }
    }

    chars.push({ char: line[i], color: currentColor });
    i++;
  }

  return chars
    .map(({ char, color }) => {
      const style = color ? `color:rgb(${color.replace(/;/g, ",")})` : "";
      const displayChar = char === " " ? "\u00A0" : escapeHtml(char);
      return `<span class="char"${style ? ` style="${style}"` : ""}>${displayChar}</span>`;
    })
    .join("");
}

function processRankArt(lines: readonly string[]): string {
  return lines.map((line) => ansiToHtml(line)).join("");
}

const selectedTiers = [5, 10, 15, 20, 25, 30, 35, 40];
const marqueeRanks = selectedTiers.map((tier) => processRankArt(RANK_ART_MAP[tier] ?? []));
const repeatedRanks = [...marqueeRanks, ...marqueeRanks, ...marqueeRanks];
const reversedRanks = [...marqueeRanks].reverse();
const marqueeRows = [
  { direction: "left", ranks: repeatedRanks },
  { direction: "right", ranks: [...reversedRanks, ...reversedRanks, ...reversedRanks] },
  { direction: "left-slow", ranks: repeatedRanks },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Rainbow Six Siege stats in your terminal. Fastfetch-style rank art and player stats via curl."
    />
    <title>r6fetch</title>
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="marquee-container" aria-hidden="true">
      {
        marqueeRows.map(({ direction, ranks }) => (
          <div class="marquee-row" data-direction={direction}>
            <div class="marquee-track">
              {ranks.map((html) => (
                <div class="rank-block">
                  <div class="rank-art" set:html={html} />
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <div class="vignette" aria-hidden="true"></div>

    <header class="header">
      <a href="https://mosly.dev" target="_blank" rel="noopener noreferrer" class="header-logo">
        <img src="/icon.png" alt="mosly.dev" width="32" height="32" />
      </a>
      <nav class="header-nav">
        <a href="/docs" class="nav-link nav-link--docs">docs</a>
        <a
          href="https://github.com/leomosley/r6fetch"
          target="_blank"
          rel="noopener noreferrer"
          class="nav-link nav-link--github"
        >
          github
          <svg
            class="external-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M7 17L17 7M17 7H7M17 7V17"></path>
          </svg>
        </a>
      </nav>
    </header>

    <main class="main">
      <div class="content">
        <div class="content-backdrop" aria-hidden="true"></div>
        <h1 class="title"><span class="title-r6">r6</span>fetch</h1>

        <button
          class="command"
          id="copyBtn"
          type="button"
          aria-label="Copy curl command"
          data-command={`curl ${DOMAIN}/pc/username`}
        >
          <span class="command-text">
            <span class="prompt">$</span>
            <span class="curl"
              >curl {DOMAIN}/<span class="placeholder">pc</span>/<span class="placeholder"
                >username</span
              ></span
            >
          </span>
          <span class="copy-indicator" aria-hidden="true">
            <svg
              class="copy-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              focusable="false"
            >
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <svg
              class="check-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              focusable="false"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
          <span class="visually-hidden" id="copyStatus" aria-live="polite"></span>
        </button>
      </div>
    </main>
  </body>
</html>

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --bg: #030305;
    --text: #f0f0f5;
    --text-dim: #858598;
    --mono: "JetBrains Mono", monospace;
    --accent: 232, 47, 132;
  }

  html,
  body {
    min-height: 100%;
    overflow-x: hidden;
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--mono);
    animation: page-in 0.4s ease both;
  }

  @keyframes page-in {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  .marquee-container {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    pointer-events: none;
    z-index: 0;
    opacity: 0.9;
    overflow: hidden;
  }

  .marquee-row {
    display: flex;
    width: 100%;
    overflow: hidden;
  }

  .marquee-track {
    display: flex;
    animation: marquee-left 60s linear infinite;
    will-change: transform;
  }

  [data-direction="right"] .marquee-track {
    animation: marquee-right 60s linear infinite;
  }

  [data-direction="left-slow"] .marquee-track {
    animation: marquee-left 90s linear infinite;
  }

  @keyframes marquee-left {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-33.333%);
    }
  }

  @keyframes marquee-right {
    0% {
      transform: translateX(-33.333%);
    }
    100% {
      transform: translateX(0);
    }
  }

  .rank-block {
    flex-shrink: 0;
    position: relative;
  }

  .rank-art {
    font-family: var(--mono);
    font-size: 10px;
    line-height: 1.2;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(36, 1ch);
    grid-auto-rows: 1.2em;
    font-variant-ligatures: none;
    font-feature-settings:
      "liga" 0,
      "calt" 0,
      "kern" 0;
    -webkit-font-smoothing: antialiased;
    text-rendering: geometricPrecision;
  }

  .rank-art span {
    display: contents;
  }

  .rank-art .char {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 1ch;
    overflow: hidden;
  }

  .vignette {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background: radial-gradient(
      ellipse at center,
      transparent 10%,
      rgba(3, 3, 5, 0.5) 40%,
      rgba(3, 3, 5, 0.9) 70%,
      var(--bg) 100%
    );
  }

  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 2rem;
    pointer-events: none;
  }

  .header-logo {
    pointer-events: auto;
    display: flex;
    align-items: center;
    opacity: 0.8;
    transition: opacity 0.15s ease;
  }

  .header-logo:hover {
    opacity: 1;
  }

  .header-logo img {
    width: 32px;
    height: 32px;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    pointer-events: auto;
  }

  .nav-link {
    font-family: var(--mono);
    font-size: 0.875rem;
    text-decoration: none;
    transition: opacity 0.15s ease;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.35rem 0;
  }

  .nav-link--docs {
    color: var(--text);
    opacity: 0.9;
  }

  .nav-link--docs:hover {
    opacity: 1;
  }

  .nav-link--github {
    color: var(--text-dim);
  }

  .nav-link--github:hover {
    color: var(--text);
  }

  .external-icon {
    width: 14px;
    height: 14px;
    stroke-width: 2.5;
  }

  .main {
    position: relative;
    z-index: 10;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    pointer-events: none;
  }

  .content {
    text-align: center;
    max-width: 700px;
    position: relative;
  }

  .content-backdrop {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 140%;
    height: 180%;
    background: radial-gradient(
      ellipse at center,
      rgba(3, 3, 5, 0.95) 0%,
      rgba(3, 3, 5, 0.85) 30%,
      rgba(3, 3, 5, 0.5) 60%,
      transparent 80%
    );
    pointer-events: none;
    z-index: -1;
  }

  .title {
    font-size: clamp(3rem, 15vw, 10rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.85;
    margin-bottom: 2.5rem;
    color: var(--text);
    text-shadow:
      0 0 60px rgba(var(--accent), 0.4),
      0 0 120px rgba(var(--accent), 0.2);
    user-select: none;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .title-r6 {
    color: rgb(var(--accent));
    text-shadow:
      0 0 60px rgba(var(--accent), 0.5),
      0 0 120px rgba(var(--accent), 0.3);
  }

  .command {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--mono);
    pointer-events: auto;
    font-size: clamp(0.7rem, 2.5vw, 0.95rem);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 9999px;
    padding: 0.875rem 1.5rem;
    color: var(--text);
    cursor: pointer;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      box-shadow 0.15s ease;
    position: relative;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    max-width: calc(100vw - 2rem);
  }

  .command:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(var(--accent), 0.25);
    box-shadow: 0 0 30px rgba(var(--accent), 0.1);
  }

  .command:active {
    transform: scale(0.98);
  }

  .command-text {
    display: flex;
    gap: 0.5em;
    min-width: 0;
  }

  .prompt {
    color: rgb(var(--accent));
  }

  .curl {
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .placeholder {
    color: var(--text-dim);
  }

  .copy-indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    position: relative;
  }

  .copy-icon,
  .check-icon {
    position: absolute;
    width: 14px;
    height: 14px;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  .copy-icon {
    color: var(--text-dim);
    opacity: 1;
    transform: scale(1);
  }

  .check-icon {
    color: #50c878;
    opacity: 0;
    transform: scale(0.5);
  }

  .command:hover .copy-icon {
    color: var(--text);
  }

  .command.copied .copy-icon {
    opacity: 0;
    transform: scale(0.5);
  }

  .command.copied .check-icon {
    opacity: 1;
    transform: scale(1);
  }

  .header-logo:focus-visible,
  .nav-link:focus-visible,
  .command:focus-visible {
    outline: 2px solid rgb(var(--accent));
    outline-offset: 4px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 600px) {
    .marquee-container {
      gap: 0.5rem;
    }

    .marquee-track {
      gap: 1.5rem;
    }

    .rank-art {
      font-size: 7px;
    }

    .command {
      padding: 0.75rem 1rem;
    }

    .header {
      padding: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    body {
      animation: none;
    }

    .marquee-track {
      animation: none;
    }

    .command,
    .copy-icon,
    .check-icon {
      transition: none;
    }
  }
</style>

<script>
  const copyButton = document.querySelector("#copyBtn");
  const copyStatus = document.querySelector("#copyStatus");

  if (copyButton instanceof HTMLButtonElement && copyStatus instanceof HTMLSpanElement) {
    copyButton.addEventListener("click", async () => {
      const command = copyButton.dataset.command;

      if (command === undefined) {
        copyStatus.textContent = "Copy failed";
        return;
      }

      try {
        await navigator.clipboard.writeText(command);
        copyButton.classList.add("copied");
        copyStatus.textContent = "Command copied";
        window.setTimeout(() => {
          copyButton.classList.remove("copied");
          copyStatus.textContent = "";
        }, 2000);
      } catch {
        copyStatus.textContent = "Copy failed";
      }
    });
  }
</script>
