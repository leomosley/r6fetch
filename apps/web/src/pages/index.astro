---
import { RANK_ART_MAP, RANK_COLORS_MAP } from "@r6fetch/renderer";

const DOMAIN = import.meta.env.PUBLIC_DOMAIN ?? "r6fetch.cc";

// Rank names for display
const RANK_NAMES = [
  "Unranked",
  "Copper V",
  "Copper IV",
  "Copper III",
  "Copper II",
  "Copper I",
  "Bronze V",
  "Bronze IV",
  "Bronze III",
  "Bronze II",
  "Bronze I",
  "Silver V",
  "Silver IV",
  "Silver III",
  "Silver II",
  "Silver I",
  "Gold V",
  "Gold IV",
  "Gold III",
  "Gold II",
  "Gold I",
  "Platinum V",
  "Platinum IV",
  "Platinum III",
  "Platinum II",
  "Platinum I",
  "Emerald V",
  "Emerald IV",
  "Emerald III",
  "Emerald II",
  "Emerald I",
  "Diamond V",
  "Diamond IV",
  "Diamond III",
  "Diamond II",
  "Diamond I",
  "Champion",
];

// Convert ANSI escape codes to HTML with each character in its own cell
function ansiToHtml(line: string): string {
  // Parse ANSI and extract characters with their colors
  const chars: { char: string; color?: string }[] = [];
  let currentColor: string | undefined;
  let i = 0;

  while (i < line.length) {
    // Check for ANSI escape sequence
    if (line[i] === "\u001b" && line[i + 1] === "[") {
      const end = line.indexOf("m", i);
      if (end !== -1) {
        const seq = line.slice(i + 2, end);
        if (seq === "0") {
          currentColor = undefined;
        } else if (seq.startsWith("38;2;")) {
          currentColor = seq.slice(5);
        }
        i = end + 1;
        continue;
      }
    }

    chars.push({ char: line[i], color: currentColor });
    i++;
  }

  // Build HTML with each character in its own fixed-width cell
  return chars
    .map(({ char, color }) => {
      const style = color ? `color:rgb(${color.replace(/;/g, ",")})` : "";
      // Use a non-breaking space for regular spaces to prevent collapse
      const displayChar = char === " " ? "\u00A0" : char;
      return `<span class="char"${style ? ` style="${style}"` : ""}>${displayChar}</span>`;
    })
    .join("");
}

// Process rank art - join lines with empty string since grid handles rows
function processRankArt(lines: readonly string[]): string {
  return lines.map((line) => ansiToHtml(line)).join("");
}

// Process all rank art into HTML
const rankArtHtml = RANK_ART_MAP.map((lines: readonly string[], tier: number) => ({
  tier,
  name: RANK_NAMES[tier],
  color: RANK_COLORS_MAP[tier],
  html: processRankArt(lines),
}));

// Select a diverse set of ranks for the marquee (skip unranked and some similar ones)
const selectedTiers = [5, 10, 15, 20, 25, 30, 35, 40]; // One from each tier + champion I
const marqueeRanks = selectedTiers.map((tier) => rankArtHtml[tier]);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Rainbow Six Siege stats in your terminal. Fastfetch-style rank art and player stats via curl."
    />
    <title>r6fetch</title>
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=block"
      rel="stylesheet"
    />
  </head>
  <body class="loading">
    <!-- Marquee background -->
    <div class="marquee-container" aria-hidden="true">
      <!-- Row 1 - moves left -->
      <div class="marquee-row" data-direction="left">
        <div class="marquee-track">
          {
            [...marqueeRanks, ...marqueeRanks, ...marqueeRanks].map((rank) => (
              <div
                class="rank-block"
                style={`--rank-color: ${rank.color[0]}, ${rank.color[1]}, ${rank.color[2]}`}
              >
                <div class="rank-art" set:html={rank.html} />
              </div>
            ))
          }
        </div>
      </div>

      <!-- Row 2 - moves right -->
      <div class="marquee-row" data-direction="right">
        <div class="marquee-track">
          {
            [
              ...marqueeRanks.slice().reverse(),
              ...marqueeRanks.slice().reverse(),
              ...marqueeRanks.slice().reverse(),
            ].map((rank) => (
              <div
                class="rank-block"
                style={`--rank-color: ${rank.color[0]}, ${rank.color[1]}, ${rank.color[2]}`}
              >
                <div class="rank-art" set:html={rank.html} />
              </div>
            ))
          }
        </div>
      </div>

      <!-- Row 3 - moves left (slower) -->
      <div class="marquee-row" data-direction="left-slow">
        <div class="marquee-track">
          {
            [...marqueeRanks, ...marqueeRanks, ...marqueeRanks].map((rank) => (
              <div
                class="rank-block"
                style={`--rank-color: ${rank.color[0]}, ${rank.color[1]}, ${rank.color[2]}`}
              >
                <div class="rank-art" set:html={rank.html} />
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Vignette overlay -->
    <div class="vignette" aria-hidden="true"></div>

    <!-- Header -->
    <header class="header">
      <a href="https://mosly.dev" target="_blank" rel="noopener noreferrer" class="header-logo">
        <img src="/icon.png" alt="mosly.dev" width="32" height="32" />
      </a>
      <nav class="header-nav">
        <a href="/docs" class="nav-link nav-link--docs">docs</a>
        <a
          href="https://github.com/leomosley/r6fetch"
          target="_blank"
          rel="noopener noreferrer"
          class="nav-link nav-link--github"
        >
          github
          <svg
            class="external-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M7 17L17 7M17 7H7M17 7V17"></path>
          </svg>
        </a>
      </nav>
    </header>

    <!-- Main content -->
    <main class="main">
      <div class="content">
        <div class="content-backdrop" aria-hidden="true"></div>
        <h1 class="title"><span class="title-r6">r6</span>fetch</h1>

        <button class="command" id="copyBtn" type="button" aria-label="Copy curl command">
          <span class="command-text">
            <span class="prompt">$</span>
            <span class="curl"
              >curl {DOMAIN}/<span class="placeholder">pc</span>/<span class="placeholder"
                >username</span
              ></span
            >
          </span>
          <span class="copy-indicator" id="copyIndicator">
            <svg
              class="copy-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <svg
              class="check-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
        </button>
      </div>
    </main>
  </body>
</html>

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --bg: #030305;
    --text: #f0f0f5;
    --text-dim: #505060;
    --mono: "JetBrains Mono", monospace;
    --accent: 196, 13, 98;
  }

  html,
  body {
    height: 100%;
    overflow: hidden;
  }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--mono);
  }

  /* Loading state - hide content until fonts loaded */
  body.loading {
    opacity: 0;
  }

  body.loaded {
    opacity: 1;
    transition: opacity 0.4s ease;
  }

  /* ═══════════════════════════════════════════════════
     MARQUEE BACKGROUND
     ═══════════════════════════════════════════════════ */
  .marquee-container {
    position: fixed;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    pointer-events: none;
    z-index: 0;
    opacity: 0.9;
    overflow: hidden;
  }

  .marquee-row {
    display: flex;
    width: 100%;
    overflow: hidden;
  }

  .marquee-track {
    display: flex;
    animation: marquee-left 60s linear infinite;
    will-change: transform;
  }

  [data-direction="right"] .marquee-track {
    animation: marquee-right 60s linear infinite;
  }

  [data-direction="left-slow"] .marquee-track {
    animation: marquee-left 90s linear infinite;
  }

  @keyframes marquee-left {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-33.333%);
    }
  }

  @keyframes marquee-right {
    0% {
      transform: translateX(-33.333%);
    }
    100% {
      transform: translateX(0);
    }
  }

  .rank-block {
    flex-shrink: 0;
    position: relative;
  }

  .rank-art {
    /*
     * Use a CSS grid approach: each character gets exactly 1ch width.
     * This forces true monospace rendering regardless of the actual
     * character widths in the font.
     */
    font-family: var(--mono);
    font-size: 10px;
    line-height: 1.2;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(36, 1ch);
    grid-auto-rows: 1.2em;
    /* Disable any font features that could affect width */
    font-variant-ligatures: none;
    font-feature-settings:
      "liga" 0,
      "calt" 0,
      "kern" 0;
    -webkit-font-smoothing: antialiased;
    text-rendering: geometricPrecision;
  }

  .rank-art span {
    display: contents;
  }

  .rank-art .char {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 1ch;
    overflow: hidden;
  }

  /* ═══════════════════════════════════════════════════
     VIGNETTE OVERLAY
     ═══════════════════════════════════════════════════ */
  .vignette {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background: radial-gradient(
      ellipse at center,
      transparent 10%,
      rgba(3, 3, 5, 0.5) 40%,
      rgba(3, 3, 5, 0.9) 70%,
      var(--bg) 100%
    );
  }

  /* ═══════════════════════════════════════════════════
     HEADER
     ═══════════════════════════════════════════════════ */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 2rem;
    pointer-events: none;
  }

  .header-logo {
    pointer-events: auto;
    display: flex;
    align-items: center;
    opacity: 0.8;
    transition: opacity 0.15s ease;
  }

  .header-logo:hover {
    opacity: 1;
  }

  .header-logo img {
    width: 32px;
    height: 32px;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    pointer-events: auto;
  }

  .nav-link {
    font-family: var(--mono);
    font-size: 0.875rem;
    text-decoration: none;
    transition: opacity 0.15s ease;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link--docs {
    color: var(--text);
    opacity: 0.9;
  }

  .nav-link--docs:hover {
    opacity: 1;
  }

  .nav-link--github {
    color: var(--text-dim);
  }

  .nav-link--github:hover {
    color: var(--text);
  }

  .external-icon {
    width: 14px;
    height: 14px;
    stroke-width: 2.5;
  }

  /* ═══════════════════════════════════════════════════
     MAIN CONTENT
     ═══════════════════════════════════════════════════ */
  .main {
    position: relative;
    z-index: 10;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    pointer-events: none;
  }

  .content {
    text-align: center;
    max-width: 700px;
    position: relative;
  }

  .content-backdrop {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 140%;
    height: 180%;
    background: radial-gradient(
      ellipse at center,
      rgba(3, 3, 5, 0.95) 0%,
      rgba(3, 3, 5, 0.85) 30%,
      rgba(3, 3, 5, 0.5) 60%,
      transparent 80%
    );
    pointer-events: none;
    z-index: -1;
  }

  .title {
    font-size: clamp(3rem, 15vw, 10rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.85;
    margin-bottom: 2.5rem;
    color: var(--text);
    text-shadow:
      0 0 60px rgba(var(--accent), 0.4),
      0 0 120px rgba(var(--accent), 0.2);
    user-select: none;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .title-r6 {
    color: rgb(var(--accent));
    text-shadow:
      0 0 60px rgba(var(--accent), 0.5),
      0 0 120px rgba(var(--accent), 0.3);
  }

  /* ═══════════════════════════════════════════════════
     COMMAND BUTTON
     ═══════════════════════════════════════════════════ */
  .command {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    font-family: var(--mono);
    pointer-events: auto;
    font-size: clamp(0.7rem, 2.5vw, 0.95rem);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 9999px;
    padding: 0.875rem 1.5rem;
    color: var(--text);
    cursor: pointer;
    transition:
      background 0.15s ease,
      border-color 0.15s ease,
      box-shadow 0.15s ease;
    position: relative;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .command:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(var(--accent), 0.25);
    box-shadow: 0 0 30px rgba(var(--accent), 0.1);
  }

  .command:active {
    transform: scale(0.98);
  }

  .command-text {
    display: flex;
    gap: 0.5em;
  }

  .prompt {
    color: rgb(var(--accent));
  }

  .curl {
    color: var(--text);
  }

  .placeholder {
    color: var(--text-dim);
  }

  .copy-indicator {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    position: relative;
  }

  .copy-icon,
  .check-icon {
    position: absolute;
    width: 14px;
    height: 14px;
    transition:
      opacity 0.15s ease,
      transform 0.15s ease;
  }

  .copy-icon {
    color: var(--text-dim);
    opacity: 1;
    transform: scale(1);
  }

  .check-icon {
    color: #50c878;
    opacity: 0;
    transform: scale(0.5);
  }

  .command:hover .copy-icon {
    color: var(--text);
  }

  .command.copied .copy-icon {
    opacity: 0;
    transform: scale(0.5);
  }

  .command.copied .check-icon {
    opacity: 1;
    transform: scale(1);
  }

  /* ═══════════════════════════════════════════════════
     RESPONSIVE
     ═══════════════════════════════════════════════════ */
  @media (max-width: 600px) {
    .marquee-container {
      gap: 0.5rem;
    }

    .marquee-track {
      gap: 1.5rem;
    }

    .rank-art {
      font-size: 7px;
    }

    .command {
      padding: 0.75rem 1rem;
    }
  }

  /* ═══════════════════════════════════════════════════
     REDUCED MOTION
     ═══════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
    }

    .cursor-glow,
    .command,
    .copy-icon,
    .check-icon {
      transition: none;
    }
  }
</style>

<script is:inline define:vars={{ DOMAIN }}>
  const copyBtn = document.getElementById("copyBtn");
  const marqueeContainer = document.querySelector(".marquee-container");

  // Distortion effect settings
  const DISTORTION_RADIUS_BASE = 50;
  const DISTORTION_RADIUS_VARIANCE = 30;
  const GLITCH_CHARS = "!@#$%^&*()_+-=[]{}|;:',.<>?/\\`~░▒▓█▄▀■□▪▫";

  // Store original character data
  const charElements = [];
  const originalChars = new Map();
  const distortedChars = new Map();
  const charRadiusOffsets = new Map();

  // Track mouse position
  let mouseX = -1000;
  let mouseY = -1000;
  let isMouseInWindow = false;
  let rafId = null;

  // Collect all character elements
  function initDistortion() {
    const chars = marqueeContainer.querySelectorAll(".char");
    chars.forEach((el) => {
      charElements.push(el);
      originalChars.set(el, el.textContent);
      // Give each character its own random radius offset for organic feel
      charRadiusOffsets.set(el, (Math.random() - 0.5) * 2 * DISTORTION_RADIUS_VARIANCE);
    });
  }

  // Get random glitch character
  function getGlitchChar() {
    return GLITCH_CHARS[Math.floor(Math.random() * GLITCH_CHARS.length)];
  }

  // Restore a character to original
  function restoreChar(el) {
    if (distortedChars.has(el)) {
      el.textContent = originalChars.get(el);
      distortedChars.delete(el);
    }
  }

  // Distort a character
  function distortChar(el) {
    if (!distortedChars.has(el)) {
      distortedChars.set(el, true);
    }
    // Keep changing the glitch char for active effect
    el.textContent = getGlitchChar();
  }

  // Update distortion effect (runs continuously via RAF)
  function updateDistortion() {
    if (!isMouseInWindow) {
      rafId = requestAnimationFrame(updateDistortion);
      return;
    }

    charElements.forEach((el) => {
      const rect = el.getBoundingClientRect();
      const charX = rect.left + rect.width / 2;
      const charY = rect.top + rect.height / 2;

      const dist = Math.sqrt((mouseX - charX) ** 2 + (mouseY - charY) ** 2);
      const charRadius = DISTORTION_RADIUS_BASE + charRadiusOffsets.get(el);

      if (dist < charRadius) {
        // Probability of glitching based on distance (closer = more likely)
        const probability = 1 - dist / charRadius;
        if (Math.random() < probability * 0.8) {
          distortChar(el);
        }
      } else {
        restoreChar(el);
      }
    });

    rafId = requestAnimationFrame(updateDistortion);
  }

  // Handle mouse movement - just update position
  function handleMouseMove(e) {
    mouseX = e.clientX;
    mouseY = e.clientY;
    isMouseInWindow = true;
  }

  // Restore all on mouse leave
  function handleMouseLeave() {
    isMouseInWindow = false;
    mouseX = -1000;
    mouseY = -1000;
    distortedChars.forEach((_, el) => {
      el.textContent = originalChars.get(el);
    });
    distortedChars.clear();
  }

  // Copy button handler
  async function handleCopy() {
    const command = `curl ${DOMAIN}/pc/username`;

    try {
      await navigator.clipboard.writeText(command);
      copyBtn.classList.add("copied");

      setTimeout(() => {
        copyBtn.classList.remove("copied");
      }, 2000);
    } catch (err) {
      // Fallback
      const textArea = document.createElement("textarea");
      textArea.value = command;
      textArea.style.position = "fixed";
      textArea.style.opacity = "0";
      document.body.appendChild(textArea);
      textArea.select();
      document.execCommand("copy");
      document.body.removeChild(textArea);

      copyBtn.classList.add("copied");
      setTimeout(() => {
        copyBtn.classList.remove("copied");
      }, 2000);
    }
  }

  // Initialize and set up event listeners
  initDistortion();
  document.addEventListener("mousemove", handleMouseMove);
  document.addEventListener("mouseleave", handleMouseLeave);
  copyBtn.addEventListener("click", handleCopy);

  // Start the continuous distortion update loop
  rafId = requestAnimationFrame(updateDistortion);

  // Fade in after fonts loaded
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(() => {
      document.body.classList.remove("loading");
      document.body.classList.add("loaded");
    });
  } else {
    // Fallback for browsers without font loading API
    window.addEventListener("load", () => {
      document.body.classList.remove("loading");
      document.body.classList.add("loaded");
    });
  }
</script>
