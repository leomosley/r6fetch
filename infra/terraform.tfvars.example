# Copy this file to terraform.tfvars and fill in real values.
# Never commit terraform.tfvars — it is gitignored.

cloudflare_api_token  = "REPLACE_WITH_CLOUDFLARE_API_TOKEN"
cloudflare_account_id = "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID"
cloudflare_zone_id    = "REPLACE_WITH_CLOUDFLARE_ZONE_ID"
stats_cc_api_key      = "REPLACE_WITH_STATS_CC_API_KEY"
r6data_api_key        = "REPLACE_WITH_LEGACY_R6DATA_API_KEY"
domain                = "r6fetch.cc"
