{
  "name": "r6fetch",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@r6fetch/api",
    "dev:web": "turbo run dev --filter=@r6fetch/web",
    "dev:full": "turbo run build --filter=@r6fetch/web && turbo run dev --filter=@r6fetch/api",
    "gen:rank-art": "bun scripts/gen-rank-art.ts"
  },
  "devDependencies": {
    "@types/sharp": "^0.32.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.34.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "packageManager": "bun@1.2.0"
}
