{
  "name": "r6fetch",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "bun run typecheck:ts && bun run typecheck:rust",
    "typecheck:ts": "turbo run typecheck",
    "typecheck:rust": "cargo check -p r6-client -p renderer && cargo check -p r6-api --target wasm32-unknown-unknown",
    "test:rust": "cargo test -p r6-client -p renderer",
    "lint": "turbo run lint",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@r6fetch/api",
    "dev:web": "turbo run dev --filter=@r6fetch/web",
    "dev:full": "turbo run build --filter=@r6fetch/web && turbo run dev --filter=@r6fetch/api",
    "gen:rank-art": "bun scripts/gen-rank-art.ts && bun scripts/gen-rust-rank-art.ts",
    "gen:rust-rank-art": "bun scripts/gen-rust-rank-art.ts",
    "bruno:r6-stats": "bun scripts/run-bruno.ts"
  },
  "devDependencies": {
    "@types/sharp": "^0.32.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.34.5",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "packageManager": "bun@1.2.0"
}
